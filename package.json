{
  "name": "window-grid-kde",
  "version": "0.1.0",
  "description": "A KDE Plasma window activity and virtual desktop grid utility.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n HELPER,APP \"npm run dbus-helper\" \"env -u ELECTRON_RUN_AS_NODE electron-vite dev\"",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "dbus-helper": "node scripts/window-grid-dbus-helper.js",
    "lint": "eslint . --ext .ts,.tsx",
    "setup": "./scripts/tools/setup.sh",
    "deploy:kwin": "./scripts/tools/deploy-kwin-script.sh"
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "kde",
    "plasma"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "dbus-next": "^0.10.2",
    "electron": "^37.0.0",
    "electron-vite": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.60.1"
  }
}
